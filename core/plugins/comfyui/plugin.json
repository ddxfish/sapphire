{
  "name": "comfyui",
  "short_display_name": "ComfyUI",
  "version": "2.2.0",
  "description": "ComfyUI: generate images and video with your own workflows, on this machine or another one",
  "author": "sapphire",
  "icon": "🎨",
  "priority": 50,
  "default_enabled": false,
  "settingsUI": "plugin",
  "capabilities": {
    "app": {
      "label": "ComfyUI",
      "icon": "🎨",
      "description": "Run your ComfyUI workflows by hand: prompt, shape and settings on the left, the result large on the right"
    },
    "tools": ["tools/comfy_tools.py"],
    "routes": [
      {"method": "GET", "path": "workflows", "handler": "routes/api.py:list_workflows"},
      {"method": "POST", "path": "workflows", "handler": "routes/api.py:upload"},
      {"method": "POST", "path": "import", "handler": "routes/api.py:import_last"},
      {"method": "PUT", "path": "workflows/{name}", "handler": "routes/api.py:update"},
      {"method": "DELETE", "path": "workflows/{name}", "handler": "routes/api.py:delete"},
      {"method": "GET", "path": "workflows/{name}/file", "handler": "routes/api.py:download"},
      {"method": "POST", "path": "workflows/{name}/check", "handler": "routes/api.py:check"},
      {"method": "POST", "path": "test", "handler": "routes/api.py:test"},
      {"method": "POST", "path": "run", "handler": "routes/api.py:run"},
      {"method": "GET", "path": "run/{job}", "handler": "routes/api.py:run_state", "live": true},
      {"method": "DELETE", "path": "run/{job}", "handler": "routes/api.py:run_stop"},
      {"method": "GET", "path": "outputs", "handler": "routes/api.py:outputs"},
      {"method": "GET", "path": "file/{name}", "handler": "routes/api.py:file", "media": true},
      {"method": "DELETE", "path": "outputs", "handler": "routes/api.py:clear_outputs"}
    ],
    "settings": [
      {
        "key": "comfy_url",
        "type": "string",
        "label": "ComfyUI address",
        "default": "http://127.0.0.1:8188",
        "help": "Where ComfyUI runs. On another machine: its address, with ComfyUI started with --listen."
      },
      {
        "key": "default_workflow",
        "type": "string",
        "label": "Default workflow",
        "default": "",
        "help": "The workflow used when the AI names none. Empty = the first in the list."
      },
      {
        "key": "timeout",
        "type": "number",
        "label": "Image wait (seconds)",
        "default": 300,
        "help": "The longest to wait for an image workflow."
      },
      {
        "key": "video_timeout",
        "type": "number",
        "label": "Video wait (seconds)",
        "default": 1200,
        "help": "The longest to wait for a video or audio workflow."
      }
    ]
  }
}
