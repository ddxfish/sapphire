{
  "manifest_version": 3,
  "name": "Sapphire Browser Bridge",
  "short_name": "Sapphire",
  "version": "0.2.2",
  "description": "Lets your own Sapphire read and use the tabs you share with her, in this browser. It connects only to the Sapphire address you give it.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["debugger", "tabs", "tabGroups", "offscreen", "storage", "alarms", "downloads", "activeTab", "scripting"],
  "background": {"service_worker": "worker.js"},
  "action": {"default_popup": "popup.html", "default_title": "Sapphire"},
  "icons": {"16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png"}
}
